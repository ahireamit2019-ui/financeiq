# FinanceIQ environment variables (all optional)
#
# The app works without any keys (Anthropic key is normally entered by each
# user in the Settings panel and stored in their browser's localStorage).
# Setting ANTHROPIC_API_KEY here makes it the server-wide default/fallback.

# Anthropic API key (used for AI scorecards, geopolitical impact tags)
ANTHROPIC_API_KEY=

# Port to run on (Render/Railway set this automatically)
PORT=5000
